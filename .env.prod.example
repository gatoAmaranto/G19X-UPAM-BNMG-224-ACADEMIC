# ==============================================================================
# Configuracion General de Django (PRODUCCION)
# ==============================================================================
DEBUG=False
SECRET_KEY=tu_secret_key_criptografica_segura_de_al_menos_50_caracteres
ALLOWED_HOSTS=localhost,127.0.0.1,backend,tu_dominio.com

# ==============================================================================
# Google AI Studio API Key (Gemini 3.8 Flash / 3.6 Flash)
# Obten tu clave en https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# ==============================================================================
# Configuracion de Base de Datos Institucional (PostgreSQL)
# ==============================================================================
USE_POSTGRES=True
POSTGRES_DB=hr_autoservice_db
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=tu_password_segura_de_postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# Cache y Cola de Mensajeria (Redis)
# ==============================================================================
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Configuracion Backend de Auth0 (Validacion JWT Bearer RS256 con JWKS)
# ==============================================================================
AUTH0_DOMAIN=tu_dominio.us.auth0.com
AUTH0_CLIENT_ID=tu_client_id_de_auth0
AUTH0_CLIENT_SECRET=tu_client_secret_de_auth0
AUTH0_AUDIENCE=https://tu_dominio.us.auth0.com/api/v2/

# ==============================================================================
# Variables de Entorno para Frontend React (Vite / Nginx en Produccion)
# ==============================================================================
VITE_AUTH0_DOMAIN=tu_dominio.us.auth0.com
VITE_AUTH0_CLIENT_ID=tu_client_id_de_auth0
VITE_AUTH0_AUDIENCE=https://tu_dominio.us.auth0.com/api/v2/
VITE_API_BASE_URL=/api

# ==============================================================================
# Configuracion de CORS (Cross-Origin Resource Sharing)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080,https://tu_dominio.com

# ==============================================================================
# Puerto del Frontend en el Servidor Anfitrion (Host)
# ==============================================================================
# Puerto externo por el cual se accedera a la aplicacion en el host. Por defecto es 80.
# Si el puerto 80 esta ocupado por otro servicio en el host (ej. Apache o Nginx local),
# puedes cambiarlo a otro puerto disponible (ej. 8080).
FRONTEND_PORT=80
