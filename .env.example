# ==============================================================================
# Configuracion General de Django
# ==============================================================================
DEBUG=True
SECRET_KEY=tu_secret_key_de_django_aqui
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# ==============================================================================
# Google AI Studio API Key (Gemini 3.8 Flash / 3.6 Flash)
# Obten tu clave en https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# ==============================================================================
# Configuracion de Base de Datos (PostgreSQL)
# ==============================================================================
POSTGRES_DB=hr_autoservice_db
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=tu_password_segura_de_postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# Cache y Cola de Mensajeria (Redis)
# ==============================================================================
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Configuracion Backend de Auth0 (Validacion JWT Bearer RS256 con JWKS)
# ==============================================================================
AUTH0_DOMAIN=tu_dominio.auth0.com
AUTH0_CLIENT_ID=tu_client_id_de_auth0
AUTH0_CLIENT_SECRET=tu_client_secret_de_auth0
AUTH0_AUDIENCE=https://tu_dominio.auth0.com/api/v2/

# ==============================================================================
# Variables de Entorno para Frontend React (Vite)
# ==============================================================================
VITE_AUTH0_DOMAIN=tu_dominio.auth0.com
VITE_AUTH0_CLIENT_ID=tu_client_id_de_auth0
VITE_AUTH0_AUDIENCE=https://tu_dominio.auth0.com/api/v2/
VITE_API_BASE_URL=http://localhost:8000/api

# ==============================================================================
# Configuracion de CORS (Cross-Origin Resource Sharing)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
